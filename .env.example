BOT_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_application_client_id_here

# Optional: set this for instant command updates in one test server.
GUILD_ID=your_discord_server_id_here

# Optional bot behavior.
AUTO_DEPLOY_COMMANDS=false
BRAND_NAME=Zenoria
EMBED_COLOR=E2231A
DATA_FILE=./data/state.json

# Optional Supabase Storage for /savefile.
# Create a Supabase Storage bucket, then fill these in.
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=discord-files
SUPABASE_STORAGE_PUBLIC=false
SUPABASE_SIGNED_URL_EXPIRES_SECONDS=3600

# Setup behavior.
WIPE_CHANNELS_ON_SETUP=true
PROTECTED_CHANNEL_IDS=1505108163387719750
VERIFY_CHANNEL_KEY=verify
VERIFY_CHANNEL_NAME=✅・verify
LOG_CHANNEL_KEY=discord_logs
LOG_CHANNEL_NAME=🧾・discord_logs
